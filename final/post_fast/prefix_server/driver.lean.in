/-
Prefix-reuse compile server driver (postfast, 2026-11-05). Toolchain group: @@GROUP@@ (generated by prefix_backend.py).

Run as `lean --load-dynlib=psrv.so -M<mb> --run driver.lean` with the row's LEAN_PATH / LEAN_SYSROOT, cwd = the server
directory (psrv.c, built against this toolchain's lean.h: fork / _exit / SIGCHLD primitives).
stdin line 1 (JSON): {"prefix": <path of the prefix file>, "args": [["M","16000"], ["D","name","value"], ...]}
  The prefix file holds the text every request starts with (header + every command before the candidate), named like a
  fresh compile's file (c_<hex>.lean) so the main module name has the same shape. It is elaborated once, exactly as
  `lean --json <args> file` would: the shell's option handling (-M, -D in order, then runFrontend's cmdlineSnapshots /
  Elab.async defaults), processHeader, then each command through the stock (private) `Lean.Language.Lean.process.doElab`,
  stopping before the end-of-input command; every task it started (async proofs, linters, kernel checks) is awaited.
  Answer: {"__psrv__":"ready","n":<commands>,"header_ms","prefix_ms","group"} or {"__psrv__":"fatal","error"}.
Then one JSON request per line: {"id": .., "path": <full file>, "fileName": <name lean would see>, "fifo": <path>}.
  The server forks and answers {"__psrv__":"forked","id":..,"pid":..}; the child writes the compile output to the FIFO and
  exits; the parent never elaborates a candidate, so every request starts from the same state.
  The full text must start with the prefix text. The last @@K@@ prefix commands are re-parsed against the full text; the
  state after the last command whose parse (syntax with positions, end position) is unchanged is resumed with the stock
  `process.parseCmd` (all later commands and the end of input, as in a fresh run). Output: the cached header/prefix
  diagnostics + the new commands' snapshot tree, reported by the stock `SnapshotTree.runAndReport` (JSON lines, tree
  preorder, as `lean --json` prints them), then the sentinel line {"__psrv__":"done","id":..,"exit":0|1,"resume","n","ms"}
  (exit 1 iff an error was reported, as `lean` exits) or {"__psrv__":"error","id":..,"error":..}.
-/
import Lean
open Lean Elab Language Language.Lean

/-- `priv% "a.b.0.c"`: the constant with that exact name (numeric components allowed): the stock private helpers. -/
elab "priv% " s:str : term => do
  let n := (s.getString.splitOn ".").foldl (fun acc p =>
    if !p.isEmpty && p.all Char.isDigit then Name.mkNum acc p.toNat! else Name.mkStr acc p) Name.anonymous
  let some ci := (← getEnv).find? n | throwError "unknown private constant {n}"
  let us ← ci.levelParams.mapM fun _ => Meta.mkFreshLevelMVar
  return mkConst n us

/-- The trust level the shell gave this very file (`defaultTrustLevel`): the one a fresh `lean file` run gets. -/
elab "shell_trust_level%" : term => return toExpr (← getEnv).header.trustLevel

namespace PrefixServer

def doElabP := priv% "_private.Lean.Language.Lean.0.Lean.Language.Lean.process.doElab"
def parseCmdP := priv% "_private.Lean.Language.Lean.0.Lean.Language.Lean.process.parseCmd"
def shellTrust : UInt32 := shell_trust_level%

/- Process primitives from psrv.so (`--load-dynlib`): fork with the child's stdout on a FIFO and a fresh task manager,
   `_exit` without finalizers, SIGCHLD ignored (children reaped by the kernel). -/
@[extern "psrv_fork_into"] opaque forkInto (fifo : String) : IO UInt32
@[extern "psrv_exit_now"] opaque exitNow (code : UInt32) : IO Unit
@[extern "psrv_ignore_sigchld"] opaque ignoreSigchld : IO Unit
/-- The runtime memory limit the shell sets for `-M` (Lean.Shell: `Internal.setMaxMemory`; private there, so declared again). -/
@[extern "lean_internal_set_max_memory"] opaque setMaxMemoryRt (max : USize) : BaseIO Unit

/-- A prefix command kept for the request-time re-parse check (the last few commands only). -/
structure Entry where
  psBefore : Parser.ModuleParserState
  stBefore : Command.State
  stx      : Syntax
  psAfter  : Parser.ModuleParserState
  nodeIdx  : Nat
  cmdIdx   : Nat

structure Server where
  prefixText  : String
  opts        : Options
  hstx        : Syntax
  hpos        : String.Pos.Raw
  headerNodes : Array (SnapshotTask SnapshotTree)
  nodes       : Array (SnapshotTask SnapshotTree)
  cmds        : Array Syntax
  window      : Array Entry
  finalPs     : Parser.ModuleParserState
  finalSt     : Command.State
  numCmds     : Nat
  headerMs    : Nat
  prefixMs    : Nat

def leaf (d : Snapshot.Diagnostics) (cs : Array (SnapshotTask SnapshotTree) := #[]) : SnapshotTask SnapshotTree :=
  .finished none (SnapshotTree.mk { diagnostics := d } cs)

/-- `-D name=value` exactly as this toolchain's shell parses it. -/
def setConfigOption (opts : Options) (name : Name) (val : String) : IO Options := do
  if let some decl := (← getOptionDecls).find? name then
@@SET_KNOWN@@
  else
@@SET_UNKNOWN@@

def setMaxMemory (opts : Options) (n : Nat) : Options :=
@@SET_MAXMEM@@

def mkOpts (args : Array Json) : IO Options := do
  let mut opts : Options := {}
  for a in args do
    let parts ← IO.ofExcept (fromJson? a : Except String (Array String))
    if parts.size == 2 && parts[0]! == "M" then
      opts := setMaxMemory opts parts[1]!.toNat!
    else if parts.size == 3 && parts[0]! == "D" then
      opts ← setConfigOption opts parts[1]!.toName parts[2]!
    else
      throw <| .userError s!"unsupported lean argument {a.compress}"
  -- Elab.runFrontend
  let opts1 := Lean.internal.cmdlineSnapshots.setIfNotSet opts true
  let opts2 := Elab.async.setIfNotSet opts1 true
  return opts2

def window : Nat := @@K@@

def startServer (prefixPath : String) (opts : Options) : IO Server := do
  let t0 ← IO.monoMsNow
  let text ← IO.FS.readFile prefixPath
  let mainModuleName ← try moduleNameOfFileName prefixPath none catch _ => pure `_stdin
  let ictx := Parser.mkInputContext text prefixPath
  let trustLevel := shellTrust
  -- process.parseHeader
  let (hstx, hps, hlog) ← Parser.parseHeader ictx
  if hlog.hasErrors then
    throw <| .userError "header parse error in the prefix"
  let hdiag ← Snapshot.Diagnostics.ofMessageLog hlog
  let trimmed : HeaderSyntax := ⟨hstx.raw.unsetTrailing⟩
  let origStx : HeaderSyntax := hstx
  -- process.processHeader (setup as runFrontend: imports/isModule from the header syntax, no plugins)
  let mut hopts := opts
@@PROCESS_HEADER@@
  let idiag ← Snapshot.Diagnostics.ofMessageLog msgLog
  if msgLog.hasErrors then
    let mut lines := #[]
    for m in msgLog.toList do
      lines := lines.push (← m.toString)
    throw <| .userError s!"import errors in the prefix: {lines}"
  hopts ← reparseOptions hopts
  let cmdState := Elab.Command.mkState headerEnv msgLog hopts
  let cmdState := { cmdState with
    infoState := {
      enabled := true
      trees := #[Elab.InfoTree.context (.commandCtx {
        env     := headerEnv
        fileMap := ictx.fileMap
        ngen    := { namePrefix := `_import }
      }) (Elab.InfoTree.node
          (Elab.Info.ofCommandInfo { elaborator := `header, stx := trimmed })
          (trimmed.raw[2].getArgs.toList.map (fun importStx =>
            Elab.InfoTree.node (Elab.Info.ofCommandInfo {
              elaborator := `import
              stx := importStx
            }) #[].toPArray'
          )).toPArray'
      )].toPArray'
    }
  }
  let t1 ← IO.monoMsNow
  -- process.parseCmd, cmdline mode, without the end-of-input command
  let mut ps := hps
  let mut st := cmdState
  let mut cmds : Array Syntax := #[]
  let mut nodes : Array (SnapshotTask SnapshotTree) := #[]
  let mut win : Array Entry := #[]
  let mut n := 0
  repeat
    let beginPos := ps.pos
    let scope := st.scopes.head!
    let pmctx : Parser.ParserModuleContext := {
      env := st.env, options := scope.opts, currNamespace := scope.currNamespace, openDecls := scope.openDecls }
    let (stx, ps', msgLog) := profileit "parsing" scope.opts fun _ => Parser.parseCommand ictx pmctx ps .empty
    if Parser.isTerminalCommand stx then
      unless stx.isOfKind ``Parser.Command.eoi do
        throw <| .userError "a terminal command (#exit / import) inside the prefix"
      break
    let pdiag ← Snapshot.Diagnostics.ofMessageLog msgLog
    let elabPromise ← IO.Promise.new
    let cancelTk ← IO.CancelToken.new
    let bundle : SnapshotBundle DynamicSnapshot := { old? := none, new := elabPromise }
    let st' ← ((@@DOELAB@@).run none |>.run { ictx with } : BaseIO Command.State)
    let rdiag ← Snapshot.Diagnostics.ofMessageLog st'.messages
    win := win.push { psBefore := ps, stBefore := st, stx, psAfter := ps', nodeIdx := nodes.size, cmdIdx := cmds.size }
    if win.size > window then
      win := win.extract 1 win.size
    nodes := nodes.push (leaf pdiag #[leaf rdiag, leaf .empty st'.snapshotTasks])
    cmds := cmds.push stx
    ps := ps'
    st := st'
    n := n + 1
  -- every prefix task (async proofs, linters, kernel checks) finished before the first fork: a forked child has no
  -- worker threads of the parent, so it must never wait on an unfinished parent task
  for nd in nodes do
    IO.wait (← nd.get.waitAll)
  let _ ← IO.wait st.env.checked
  let t2 ← IO.monoMsNow
  return { prefixText := text, opts, hstx, hpos := hps.pos,
           headerNodes := #[leaf hdiag, leaf idiag], nodes, cmds, window := win,
           finalPs := ps, finalSt := st, numCmds := n, headerMs := t1 - t0, prefixMs := t2 - t1 }

/-- One request: returns (hasErrors, resume index = number of cached prefix commands reused). -/
def handle (srv : Server) (path fileName : String) : IO (Bool × Nat) := do
  let text ← IO.FS.readFile path
  unless text.startsWith srv.prefixText do
    throw <| .userError "the file does not start with the cached prefix"
  let ictx := Parser.mkInputContext text fileName
  let (hstx, hps, hlog) ← Parser.parseHeader ictx
  unless !hlog.hasErrors && hstx.raw.unsetTrailing.eqWithInfo srv.hstx.unsetTrailing && hps.pos == srv.hpos do
    throw <| .userError "the header parses differently"
  let mut resume : Option Entry := none
  for e in srv.window do
    let scope := e.stBefore.scopes.head!
    let pmctx : Parser.ParserModuleContext := {
      env := e.stBefore.env, options := scope.opts, currNamespace := scope.currNamespace, openDecls := scope.openDecls }
    let (stx, ps', _) := Parser.parseCommand ictx pmctx e.psBefore .empty
    unless stx.eqWithInfo e.stx && ps'.pos == e.psAfter.pos && ps'.recovering == e.psAfter.recovering do
      resume := some e
      break
  let (ps, st, nodes, cmds, ridx) := match resume with
    | some e => (e.psBefore, e.stBefore, srv.nodes.extract 0 e.nodeIdx, srv.cmds.extract 0 e.cmdIdx, e.cmdIdx)
    | none   => (srv.finalPs, srv.finalSt, srv.nodes, srv.cmds, srv.numCmds)
  let t ← do
@@REQUEST@@
      pure t
  let req : SnapshotTask SnapshotTree := { stx? := none, task := t.map (sync := true) toSnapshotTree, cancelTk? := none }
  let root := SnapshotTree.mk { diagnostics := .empty } (srv.headerNodes ++ nodes ++ #[req])
  let hasErrors ← root.runAndReport srv.opts true
  return (hasErrors, ridx)

def emit (j : Json) : IO Unit := do
  let out ← IO.getStdout
  out.putStrLn j.compress
  out.flush

def runRequest (srv : Server) (id : Json) (path fileName : String) : IO Unit := do
  try
    let t0 ← IO.monoMsNow
    let (hasErrors, ridx) ← handle srv path fileName
    let t1 ← IO.monoMsNow
    emit <| Json.mkObj [("__psrv__", "done"), ("id", id), ("exit", if hasErrors then (1 : Nat) else (0 : Nat)),
      ("resume", ridx), ("n", srv.numCmds), ("ms", t1 - t0)]
  catch e =>
    emit <| Json.mkObj [("__psrv__", "error"), ("id", id), ("error", toString e)]

/-- Request loop. Default: fork; the child (stdout = the request's FIFO, fresh task manager) elaborates the candidate
from the parent's post-prefix state and `_exit`s; the parent only answers {"__psrv__":"forked","pid":..} and never
elaborates anything, so every request starts from the same state (process-global caches of the interpreter included).
`"nofork": true` runs the request in this process (debug: shows the cross-request state leak). -/
partial def serve (srv : Server) : IO Unit := do
  let line ← (← IO.getStdin).getLine
  if line.isEmpty then
    return
  let id := (Json.parse line |>.toOption |>.bind (·.getObjVal? "id" |>.toOption)).getD Json.null
  try
    let j ← IO.ofExcept (Json.parse line)
    let path ← IO.ofExcept (j.getObjValAs? String "path")
    let fileName := (j.getObjValAs? String "fileName").toOption.getD path
    if (j.getObjValAs? Bool "nofork").toOption.getD false then
      runRequest srv id path fileName
    else
      let fifo ← IO.ofExcept (j.getObjValAs? String "fifo")
      let pid ← forkInto fifo
      if pid == 0 then
        runRequest srv id path fileName
        exitNow 0
      emit <| Json.mkObj [("__psrv__", "forked"), ("id", id), ("pid", pid.toNat)]
  catch e =>
    emit <| Json.mkObj [("__psrv__", "error"), ("id", id), ("error", toString e)]
  serve srv

end PrefixServer

open PrefixServer in
def main (_args : List String) : IO UInt32 := do
  -- the shell enables this for `lean file` (imports run their `initialize` declarations), not for `--run` / executables
  unsafe Lean.enableInitializersExecution
  -- the shell's search path: LEAN_PATH entries, then <sysroot>/lib/lean (sysroot = LEAN_SYSROOT, which the evaluator sets to the
  -- toolchain of the `lean` binary); needed by the native build, the same value under `--run`
  Lean.initSearchPath (← Lean.findSysroot)
  let line ← (← IO.getStdin).getLine
  try
    let cfg ← IO.ofExcept (Json.parse line)
    let prefixPath ← IO.ofExcept (cfg.getObjValAs? String "prefix")
    let args ← IO.ofExcept (cfg.getObjValAs? (Array Json) "args")
    let opts ← mkOpts args
    -- as the shell does after option parsing: the -M limit for this process (the children inherit it)
    let mm := args.foldl (init := 0) fun acc a => match (fromJson? a : Except String (Array String)) with
      | .ok p => if p.size == 2 && p[0]! == "M" then p[1]!.toNat! else acc
      | .error _ => acc
    if mm != 0 then
      setMaxMemoryRt (mm.toUSize * 1024 * 1024)
    let task ← IO.asTask (startServer prefixPath opts)
    let srv ← IO.ofExcept task.get
    ignoreSigchld
    emit <| Json.mkObj [("__psrv__", "ready"), ("n", srv.numCmds), ("header_ms", srv.headerMs),
      ("prefix_ms", srv.prefixMs), ("group", "@@GROUP@@")]
    serve srv
    return 0
  catch e =>
    emit <| Json.mkObj [("__psrv__", "fatal"), ("error", toString e)]
    return 1
