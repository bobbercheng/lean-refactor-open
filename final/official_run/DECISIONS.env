# Official open run decisions (infra/vast/official.sh reads this file at every phase). Sanitized copy of 2026-11-01: values as used,
# notes shortened; box ids, billing and account details removed.
RELEASE_AT="2026-11-01 06:48:24 UTC"   # the benchmark release time, set by official_ondemand.sh when it saw the release
CLOCK_START=launch       # the 48 h job clock starts at official.sh start (vLLM up, setup done), as the organizers' run.sh; both times recorded in clock_start.json
FINAL_COMMIT="1d1a31d4533bc9603e54c7e49e92e4a16458cb23"   # the package commit exported and run (= ../, the release export)
WORKERS=14               # concurrent model sessions
MAX_SESSIONS=12          # the package default; the deadline and the room schedule decide
VLLM_RECIPE=std          # the production vLLM recipe (max-num-seqs 16)
END_SECONDS=7200         # the end stage's clock at the agent deadline (the pipeline also polishes rows during the agent stage)
AUTO_BRIEF=off           # off: no auto-brief
DIALECT_CARD=off         # off: no dialect card in the sessions
GUARD_ADD=200            # the spend guard's cap for this run (USD, asks first while the run is busy)
HOLD_MAX_S=345600        # the watch's hold wait after the run (96 h; the box is kept until the upload is verified)
REFHB_ALLOW_MISSING=1    # a released row whose reference proof cannot be measured gets a FLAGGED placeholder instead of blocking start (re-measured on the next call)
# Decisions not read by the scripts:
#   the code zip ships data/official/rows.jsonl (released rows) + data/official/heartbeats.jsonl (the reference heartbeats our run used)
#   no warm-up best proofs in the open upload: the upload is exactly our run's export
